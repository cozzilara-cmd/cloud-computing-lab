<!DOCTYPE html>
<html lang="it">
<head>
  <label for="fname">First name:</label><br>
  <input type="text" id="fname" name="fname"><br>
  <label for="lname">Last name:</label><br>
  <input type="text" id="lname" name="lname">
  <input type ="button" onclick="armando()" value="click">
  <input type ="button" onclick="colore()" value="colore">
  <p id="sname">
    <p id="pname"></p>
  </p>
  <script>
    function armando() {
        let name = document.getElementById('fname').value;
        let surname = document.getElementById('lname').value;
        document.getElementById('sname').innerHTML=name;
        document.getElementById('pname').innerHTML=surname;
    }
    function colore(){
        document.getElementById('sname').style.color = 'red';
        document.getElementById('pname').style.color = 'red';
    }
  </script>
